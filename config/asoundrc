# ALSA's default device stays PulseAudio (which kd-jack bridges into JACK).
# Point an ALSA app at "jack" to talk to JACK directly: aplay -D jack song.wav
pcm.jack {
    type plug
    slave.pcm {
        type jack
        playback_ports { 0 system:playback_1 1 system:playback_2 }
        capture_ports { 0 system:capture_1 1 system:capture_2 }
    }
}
