#!/bin/sh
# kd-snap [max|left|right|top|bottom|tl|tr|bl|br|center|next|prev] [window]: fit the active window to its own monitor
# less the Openbox <margins>, or to a half/quarter of that with the same gap between them. Openbox
# applies margins to the edges of the whole X screen, so with several monitors its own Maximize and
# MoveResizeTo leave no gap where they meet. max toggles: the size before is kept in
# $XDG_RUNTIME_DIR/kd-snap/<window> and put back on the next one. next/prev: maximise it on the
# monitor after/before its own (xrandr order, wrapping round). center: two thirds of it, centred (also
# where max puts a maximised window back when there's no earlier size, e.g. one that opened maximised).
where=${1:-max}
case $where in max | left | right | top | bottom | tl | tr | bl | br | center | next | prev) ;;
*) echo "usage: kd-snap max|left|right|top|bottom|tl|tr|bl|br|center|next|prev [window]" >&2; exit 2 ;; esac
win=${2:-$(xdotool getactivewindow)} || exit
saved=${XDG_RUNTIME_DIR:-/tmp}/kd-snap/$win
mkdir -p "${saved%/*}"

# frame = client plus decorations (_NET_FRAME_EXTENTS: left, right, top, bottom)
set -- $(xprop -id "$win" _NET_FRAME_EXTENTS | cut -sd= -f2 | tr -d ,) 0 0 0 0
l=$1 r=$2 t=$3 b=$4
eval "$(xwininfo -id "$win" | awk -F: '
  /Absolute upper-left X/ { print "x=" $2 + 0 } /Absolute upper-left Y/ { print "y=" $2 + 0 }
  /Width/ { print "w=" $2 + 0 } /Height/ { print "h=" $2 + 0 }')"
fx=$((x - l)) fy=$((y - t)) fw=$((w + l + r)) fh=$((h + t + b))

# monitor nearest the frame's centre (holding it, or the closest when a layout change left the
# window off every screen), and the margins kd-theme rendered into rc.xml
case $where in next) step=1 ;; prev) step=-1 ;; *) step=0 ;; esac
set -- $(xrandr --current | grep -o ' connected[a-z ]* [0-9]*x[0-9]*+[0-9]*+[0-9]*' | awk -v cx=$((fx + fw / 2)) -v cy=$((fy + fh / 2)) -v step=$step '
  { split($NF, g, /[x+]/); m[NR] = g[1] " " g[2] " " g[3] " " g[4]
    dx = cx < g[3] ? g[3] - cx : cx >= g[3] + g[1] ? cx - g[3] - g[1] + 1 : 0
    dy = cy < g[4] ? g[4] - cy : cy >= g[4] + g[2] ? cy - g[4] - g[2] + 1 : 0
    if (NR == 1 || dx * dx + dy * dy < best) { best = dx * dx + dy * dy; i = NR } }
  END { if (NR) print m[(i - 1 + step + NR) % NR + 1] }')
[ $# = 4 ] || exit
set -- "$@" $(sed -n 's:.*<margins><top>\([0-9]*\)</top><bottom>\([0-9]*\)</bottom><left>\([0-9]*\)</left><right>\([0-9]*\)</right>.*:\1 \2 \3 \4:p' \
  "${XDG_CONFIG_HOME:-$HOME/.config}/openbox/rc.xml") 0 0 0 0
tx=$(($3 + $7)) ty=$(($4 + $5)) tw=$(($1 - $7 - $8)) th=$(($2 - $5 - $6)) gap=$7

if [ "$where" = next ] || [ "$where" = prev ]; then
  rm -f "$saved"   # its old size belongs to the other monitor
elif [ "$where" = max ]; then
  # maximised = sitting at the target's corner (terminals' size steps can stop it filling exactly)
  if [ "$fx $fy" = "$tx $ty" ] && [ -f "$saved" ]; then
    read tx ty tw th < "$saved"
    rm "$saved"
  elif [ "$fx $fy" = "$tx $ty" ] && [ $((fw * 4)) -gt $((tw * 3)) ] && [ $((fh * 4)) -gt $((th * 3)) ]; then   # not a left/top/tl snap
    where=center
  else
    echo "$fx $fy $fw $fh" > "$saved"
  fi
fi
if [ "$where" = center ]; then
  rm -f "$saved"
  cw=$((tw * 2 / 3)) ch=$((th * 2 / 3))
  tx=$((tx + (tw - cw) / 2)) ty=$((ty + (th - ch) / 2)) tw=$cw th=$ch
elif [ "$where" != max ] && [ "$where" != next ] && [ "$where" != prev ]; then
  rm -f "$saved"   # a snapped window isn't maximised; the next max starts from here
  half=$(((tw - gap) / 2))
  case $where in
  left | tl | bl) tw=$half ;;
  right | tr | br) tx=$((tx + half + gap)) tw=$((tw - half - gap)) ;;
  esac
  half=$(((th - gap) / 2))
  case $where in
  top | tl | tr) th=$half ;;
  bottom | bl | br) ty=$((ty + half + gap)) th=$((th - half - gap)) ;;
  esac
fi
# Openbox places the frame's top-left at the requested position (NorthWest gravity); size is the client's
xdotool windowsize "$win" $((tw - l - r)) $((th - t - b)) windowmove "$win" "$tx" "$ty"
