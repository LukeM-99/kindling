# generated by kd-theme: the floating "island" pill

# 1: island
rounded = 1
background_color = {{bg}} 100
# 2: active task
rounded = 1
background_color = {{bg3}} 100
# 3: urgent task
rounded = 1
background_color = {{urgent}} 100
# 4: desktop chip
rounded = 1
background_color = {{accent}} 100

panel_items = PTCEEBSP
panel_shrink = 1
panel_size = 50% {{s 36}}
panel_margin = {{s 0}} {{s 8}}
panel_padding = {{s 8}} {{s 4}} {{s 6}}
panel_background_id = 1
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
mouse_effects = 1
mouse_hover_icon_asb = 100 0 15
mouse_pressed_icon_asb = 100 0 0

button = new
button_text = ◉
button_font = Noto Sans Bold {{s 11}}
button_font_color = {{accent}} 100
button_padding = {{s 8}} {{s 0}}
button_lclick_command = rofi -show drun
button_rclick_command = kd-power

button = new
button_text = ⏻
button_font = Noto Sans Bold {{s 11}}
button_font_color = {{fg2}} 100
button_padding = {{s 6}} {{s 0}}
button_tooltip = Lock, switch user, log out, suspend, reboot, shut down
button_lclick_command = kd-power

taskbar_mode = single_desktop
taskbar_padding = {{s 0}} {{s 0}} {{s 4}}
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_hide_different_monitor = 1
taskbar_name = 1
taskbar_name_padding = {{s 9}} {{s 2}}
taskbar_name_background_id = 0
taskbar_name_active_background_id = 4
taskbar_name_font = Noto Sans Bold {{s 9}}
taskbar_name_font_color = {{fg2}} 100
taskbar_name_active_font_color = {{bg}} 100

task_text = 0
task_icon = 1
task_maximum_size = {{s 32}} {{s 28}}
task_padding = {{s 6}} {{s 3}} {{s 0}}
task_tooltip = 1
task_icon_asb = 70 0 0
task_active_icon_asb = 100 0 0
task_iconified_icon_asb = 40 -100 0
task_active_background_id = 2
task_urgent_background_id = 3
mouse_middle = close

time1_format = %a %d   %H:%M
time1_font = Noto Sans Bold {{s 9}}
clock_font_color = {{fg}} 100
clock_padding = {{s 8}} {{s 0}}
clock_tooltip = %A %d %B %Y

execp = new
execp_command = kd-jack status
execp_interval = 5
execp_font = Noto Sans {{s 9}}
execp_font_color = {{fg2}} 100
execp_padding = {{s 6}} {{s 0}}
execp_lclick_command = kd-jack
execp_rclick_command = kd-jack patch

execp = new
execp_command = kd-osd vol watch
execp_interval = 3
execp_continuous = 1
execp_font = Noto Sans {{s 9}}
execp_font_color = {{fg}} 100
execp_padding = {{s 6}} {{s 0}}
execp_lclick_command = kd-audio
execp_rclick_command = kd-audio menu
execp_mclick_command = kd-osd vol mute
execp_tooltip = click: volume · right-click: devices and apps · middle-click: mute
execp_uwheel_command = kd-osd vol up
execp_dwheel_command = kd-osd vol down

battery_hide = 101
battery_low_status = 15
# guarded: with no battery (a desktop) tint2 reports it as low and would warn at every login
battery_low_cmd = ls /sys/class/power_supply/BAT* >/dev/null 2>&1 && notify-send -u critical Battery "Plug in soon"
bat1_format = ⚡ %p
bat2_format =
bat1_font = Noto Sans {{s 9}}
battery_font_color = {{fg}} 100
battery_padding = {{s 6}} {{s 0}}
battery_tooltip = 1

systray_padding = {{s 4}} {{s 0}} {{s 6}}
systray_icon_size = {{s 16}}
systray_monitor = primary
