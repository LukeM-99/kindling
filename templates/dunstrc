# generated by kd-theme: notifications drop out of the island
[global]
    follow = mouse
    show_indicators = no
    origin = top-center
    offset = 0x56
    width = 360
    height = 160
    notification_limit = 4
    gap_size = 6
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    frame_color = "{{bg3}}"
    corner_radius = 1
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 320
    progress_bar_max_width = 330
    font = Noto Sans 10
    format = "<b>%s</b>\n%b"
    max_icon_size = 48
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "{{bg}}"
    foreground = "{{fg2}}"
    highlight = "{{accent}}"
    timeout = 4

[urgency_normal]
    background = "{{bg}}"
    foreground = "{{fg}}"
    highlight = "{{accent}}"
    timeout = 6

[urgency_critical]
    background = "{{bg}}"
    foreground = "{{fg}}"
    highlight = "{{urgent}}"
    frame_color = "{{urgent}}"
    timeout = 0

# volume/brightness from kd-osd
[osd]
    category = osd
    format = "<b>%s</b>  %b"
    history_ignore = yes
